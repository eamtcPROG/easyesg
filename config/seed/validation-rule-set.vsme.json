    {
      "id": "b3-energy-breakdown",
      "kind": "sum",
      "verdict": "inconsistency",
      "message": "validation.sum.over",
      "parts": [
        {
          "element": "EnergyConsumptionFromElectricity",
          "member": "RenewableEnergyMember"
        },
        {
          "element": "EnergyConsumptionFromElectricity",
          "member": "NonRenewableEnergyMember"
        },
        {
          "element": "EnergyConsumptionFromSelfGeneratedElectricity",
          "member": "RenewableEnergyMember"
        },
        {
          "element": "EnergyConsumptionFromSelfGeneratedElectricity",
          "member": "NonRenewableEnergyMember"
        },
        {
          "element": "EnergyConsumptionFromFuels",
          "member": "RenewableEnergyMember"
        },
        {
          "element": "EnergyConsumptionFromFuels",
          "member": "NonRenewableEnergyMember"
        }
      ],
      "total": {
        "element": "TotalEnergyConsumption"
      },
      "relation": "at_most"
    },
