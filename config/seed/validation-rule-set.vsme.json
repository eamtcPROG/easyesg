    {
      "id": "c7-value-chain-specification",
      "kind": "required",
      "verdict": "missing",
      "message": "validation.required",
      "fields": [
        {
          "element": "SpecificationOfAnyConfirmedIncidentInvolvingWorkersInTheValueChainAffectedCommunitiesConsumersAndEndUsers"
        }
      ],
      "when": {
        "kind": "is_true",
        "element": "UndertakingIsAwareOfAnyConfirmedIncidentsInvolvingWorkersInTheValueChainAffectedCommunitiesConsumersAndEndUsers"
      }
    },
    {
      "id": "c8-revenues-within-turnover",
      "kind": "sum",
      "verdict": "inconsistency",
      "message": "validation.sum.over",
      "parts": [
        {
          "element": "RevenueDerivedFromControversialWeaponsAntiPersonnelMinesClusterMunitionsChemicalWeaponsAndBiologicalWeapons"
        },
        {
          "element": "RevenueDerivedFromCultivationAndProductionOfTobacco"
        },
        {
          "element": "RevenueDerivedFromCoal"
        },
        {
          "element": "RevenueDerivedFromOil"
        },
        {
          "element": "RevenueDerivedFromGas"
        },
        {
          "element": "RevenueDerivedFromChemicalProduction"
        }
      ],
      "total": {
        "element": "Turnover"
      },
      "relation": "at_most"
