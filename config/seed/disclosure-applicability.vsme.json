{
  "rules": [
    {
      "elements": ["EmployeeTurnoverRate"],
      "condition": {
        "kind": "numeric_at_least",
        "elementKey": "NumberOfEmployees",
        "threshold": "50"
      }
    },
    {
      "elements": ["PercentageGapInPayBetweenFemaleAndMaleEmployees"],
      "condition": {
        "kind": "numeric_at_least",
        "elementKey": "NumberOfEmployees",
        "threshold": "150"
      }
    },
    {
      "elements": [
        "SiteLocatedInABiodiversitySensitiveArea",
        "SiteLocatedNearABiodiversitySensitiveArea",
        "AreaOfSiteInBiodiversitySensitiveArea"
      ],
      "condition": {
        "kind": "any_row_answered",
        "elementKeys": [
          "AddressOfSite",
          "CityOfSite",
          "CountryOfSite",
          "GPSLocationOfSite",
          "PostalCodeOfSite"
        ]
      }
    },
    {
      "elements": [
        "TotalAmountOfWaterWithdrawnFromAllSites",
        "AmountOfWaterWithdrawnAtSitesLocatedInAreasOfHighWaterStress",
        "TotalWaterConsumption",
        "WaterDischargeFromUndertakingProductionProcesses"
      ],
      "condition": {
        "kind": "member_within",
        "elementKey": "NaceSectorClassificationCodes",
        "members": [
          "nace:NACE_A",
          "nace:NACE_B",
          "nace:NACE_C",
          "nace:NACE_D",
          "nace:NACE_E"
        ]
      }
    }
  ]
}
