{
  "name": "easyesg",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant VSME sustainability reporting platform for Moldovan SMEs",
  "license": "UNLICENSED",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r build",
    "dev:up": "docker compose -f infra/compose/docker-compose.yml up -d --wait",
    "dev:down": "docker compose -f infra/compose/docker-compose.yml down",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "pnpm -r test",
    "preboundaries": "pnpm --filter @easyesg/i18n --filter @easyesg/validation build",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps/api/src apps/web/src apps/admin/src packages/ui/src packages/i18n/src",
    "boundaries:prove": "./tools/prove-boundaries.sh",
    "migrations:check": "pnpm --filter @easyesg/api db:check",
    "clean": "./tools/clean-build-outputs.sh",
    "e2e": "pnpm --filter @easyesg/api test:e2e",
    "e2e:worker": "pnpm --filter @easyesg/api test:worker",
    "pree2e:web": "pnpm --filter @easyesg/api... --filter @easyesg/web... --filter @easyesg/admin... build && ./tools/assemble-web-standalone.sh",
    "e2e:web": "playwright test --config e2e/playwright.config.ts",
    "gates": "pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries && pnpm boundaries:prove && pnpm build && pnpm openapi:check && pnpm routes:check && pnpm migrations:check && pnpm e2e && pnpm e2e:worker && pnpm e2e:web",
    "gates:scoped": "./tools/gates-scoped.sh",
    "gates:clean": "pnpm clean && pnpm gates",
    "openapi:emit": "pnpm --filter @easyesg/api openapi:emit",
    "openapi:check": "pnpm openapi:emit && pnpm --filter @easyesg/contracts generate && git diff --exit-code packages/contracts/openapi/v1.json packages/contracts/src/generated",
    "routes:check": "pnpm --filter @easyesg/admin build && git diff --exit-code apps/admin/src/app/route-tree.gen.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@playwright/test": "catalog:",
    "@types/pg": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "globals": "catalog:",
    "otpauth": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
