{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "ES2024"],
    "jsx": "react-jsx",
    "noEmit": true,
    // The catalogues are JSON and the parity suite imports them directly rather than reading
    // the filesystem — which is what keeps "types": [] below true.
    "resolveJsonModule": true,
    // Empty rather than ["node"]: these packages are isomorphic and use no Node API. React's
    // types arrive through imports, not ambient inclusion. Explicit beats "whatever @types
    // happens to be visible" — same reasoning as apps/api, opposite conclusion.
    "types": []
  },
  // `vitest.config.ts` is in the program for the reason packages/ui gives: type-aware lint resolves
  // files through the tsconfig. The build configs set their own `include`, so it is never emitted.
  "include": ["src/**/*.ts", "src/**/*.tsx", "catalogues/**/*.json", "vitest.config.ts"]
}
