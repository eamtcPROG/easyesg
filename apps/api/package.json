{
  "name": "@easyesg/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "easyesg public API — NestJS, HTTP and worker modes (architecture.md AD-1)",
  "scripts": {
    "pretest": "pnpm --filter @easyesg/i18n build",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "MODE=worker node dist/main.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "openapi:emit": "node dist/infrastructure/openapi/emit-openapi.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch"
  },
  "dependencies": {
    "@easyesg/i18n": "workspace:*",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "bullmq": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "express": "catalog:",
    "ioredis": "catalog:",
    "negotiator": "catalog:",
    "nestjs-pino": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typeorm": "catalog:",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/negotiator": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "jest": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:"
  }
}
