{
  "name": "@easyesg/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "easyesg public API \u2014 NestJS, HTTP and worker modes (architecture.md AD-1)",
  "scripts": {
    "pretest": "pnpm --filter @easyesg/i18n build",
    "pretest:e2e": "pnpm --filter @easyesg/i18n build",
    "build": "nest build",
    "postbuild": "tsc-alias -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "MODE=worker node dist/main.js",
    "db:cli": "node --env-file-if-exists=.env ./node_modules/typeorm/cli-ts-node-commonjs.js",
    "db:migrate": "pnpm db:cli migration:run -d src/infrastructure/persistence/migration.data-source.ts",
    "db:revert": "pnpm db:cli migration:revert -d src/infrastructure/persistence/migration.data-source.ts",
    "db:show": "pnpm db:cli migration:show -d src/infrastructure/persistence/migration.data-source.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:run -d dist/infrastructure/persistence/migration.data-source.js",
    "config:seed": "node --env-file-if-exists=.env -r ts-node/register src/infrastructure/configuration/seed-configuration.main.ts",
    "db:check": "pnpm db:migrate && pnpm db:revert && pnpm db:migrate && pnpm db:invariants",
    "db:invariants": "node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runTestsByPath test/schema-invariants.e2e-spec.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:cov": "jest --coverage",
    "test:e2e": "node --experimental-vm-modules --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand --passWithNoTests",
    "openapi:emit": "node dist/infrastructure/openapi/emit-openapi.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch"
  },
  "dependencies": {
    "@easyesg/i18n": "workspace:*",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "@node-rs/argon2": "catalog:",
    "bullmq": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "express": "catalog:",
    "ioredis": "catalog:",
    "negotiator": "catalog:",
    "nestjs-pino": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typeorm": "catalog:",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/negotiator": "catalog:",
    "@types/node": "catalog:",
    "@types/passport-jwt": "catalog:",
    "@types/supertest": "catalog:",
    "jest": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "tsc-alias": "catalog:"
  }
}
