{
  // The emitting config. `rootDir` lives here rather than in tsconfig.json so that dist mirrors
  // src (dist/main.js, not dist/src/main.js) while the base config can still take test/ into its
  // program for type-checking and linting — see the note in tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": { "rootDir": "./src" },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
