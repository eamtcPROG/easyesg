# apps/api — HTTP and worker modes. Copy to .env for a host run; the Compose stack supplies
# these as service environment (infra/compose).

# Which entrypoint main.ts dispatches to. 'worker' consumes the queue and serves no HTTP.
MODE=http
PORT=3000

# DR-1 / NFR-1: with this false, UC-17…48 must still pass end to end.
BILLING_ENABLED=true

# NOTE — the one setting that catches everyone. config/configuration.ts defaults DB_HOST to
# 'postgres' and REDIS_HOST to 'redis', which are the Compose SERVICE NAMES. Running apps/api
# on the host means overriding both to localhost, as below; running it inside Compose means
# leaving them as the service names. Backwards produces ENOTFOUND postgres, which reads as a
# broken stack rather than a wrong .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=esg

# Non-superuser, non-owner, RLS NOT bypassable (AD-2). Must match ESG_APP_PASSWORD in
# infra/compose/.env.
DB_USER=esg_app
DB_PASSWORD=devonly-app

# The migration owner (§7.6), used by `pnpm db:migrate` / `db:revert` and by nothing else.
# Read straight from the environment by infrastructure/persistence/migration.data-source.ts,
# which is the one place in this app permitted to bypass ConfigService — it is loaded by the
# TypeORM CLI, outside Nest, where no ConfigService exists.
#
# THIS IS LOCAL-ONLY AND MUST STAY THAT WAY. §7.7 makes the append-only guarantee depend on
# these credentials never being available to a runtime process: an owner can ALTER TABLE ...
# DISABLE TRIGGER or drop it outright. In staging and production the migration job carries
# them and the api/worker containers do not — never add them to a runtime service's
# environment to "keep the files consistent".
DB_MIGRATOR_USER=esg_migrator
DB_MIGRATOR_PASSWORD=devonly-migrator

REDIS_HOST=localhost
REDIS_PORT=6379
