# apps/web — tenant application. Copy to .env.local for a host run; the Compose stack
# supplies these as service environment (infra/compose).

# The public API, reached server-side only. AD-9: this app is an ordinary client of the same
# versioned surface as apps/admin — never a privileged route into the database (DR-11).
# Inside Compose this is the service name, not localhost.
API_BASE_URL=http://api:3000/api/v1

# Mirrors apps/api's flag. With billing off, the commerce route subtree renders its
# unavailable state and UC-17…48 must still pass end to end (A6, DR-1).
BILLING_ENABLED=true

# Secret used to seal the session cookie. 32+ bytes from a CSPRNG. Never committed —
# SOPS-encrypted per environment (§10.6).
SESSION_SECRET=replace-me-with-32-bytes-of-csprng-output

PORT=3000
