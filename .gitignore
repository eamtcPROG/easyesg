# Dependencies
node_modules/
.pnpm-store/
pnpm-debug.log*

# Build output
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# Tests and reports
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Secrets — only the .example templates are tracked
.env
.env.*
!.env.example
!.env.*.example
apps/*/env/*
!apps/*/env/.env.example

# Keys and service-account credentials never belong in the repo.
#
# `/credentials/` is ANCHORED, and that leading slash is load-bearing (27 Aug 2026). Written bare
# it matched any directory of that name at any depth, and on 26 Aug 2026 it silently swallowed all
# of `apps/web/src/features/credentials/` and S-28's page — eleven source files, committed as
# absent, with `git status` clean the whole time because an ignored file is not untracked. The
# branch could not build from a fresh clone; nothing local could see it, since the files were
# present on the machine that wrote them.
#
# The extension rules below are what actually protect key material, and they stay unanchored on
# purpose: a `.pem` is a secret wherever it lands, whereas a *directory name* is a word this
# product also uses for a domain concept. Any new directory rule here needs the same question
# asked of it — could this name mean something in `src/`?
/credentials/
*.pem
*.p12
*.key

# Generated and tenant data. Fiscal documents, exports and backups are produced
# at runtime and retained by the archive (DR-8), never by git.
uploads/
exports/
backups/
infra/**/data/

# NOTE: config/efrag/ holds the official EFRAG Digital Template binaries, per
# taxonomy version. Those are inputs the export pipeline needs — keep them tracked.

# Per-machine Claude Code state. Tracked skills live in .claude/skills/
# (symlinks into .agents/skills/) and are committed; these are not.
.claude/settings.local.json
.claude/plans/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp
