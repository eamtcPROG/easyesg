# infra/compose — local development stack. Copy to .env in this directory:
#
#     cd infra/compose && cp .env.example .env
#
# Compose resolves .env against the compose file's own directory, so this must live here and
# the stack must be started from here (or with -f infra/compose/docker-compose.yml).
#
# These are LOCAL, SYNTHETIC values for a throwaway container. No real credential ever lands
# in a .example — .env itself is gitignored. In staging and production the equivalent file is
# the SOPS+age-encrypted bootstrap .env of architecture.md §12.5.3, and everything past
# bootstrap comes from OpenBao rather than from a file at all.

# The image superuser. Creates the cluster and runs init/init.sh; no application ever
# connects as this.
POSTGRES_PASSWORD=devonly-postgres

# The three login roles created by init/init.sh (§7.6). esg_app is the one apps/api uses —
# it must match DB_PASSWORD in apps/api/.env.
ESG_APP_PASSWORD=devonly-app
ESG_WORKER_PASSWORD=devonly-worker
ESG_ADMIN_RO_PASSWORD=devonly-admin-ro
