# Compose's variables for docker-compose.staging.yml (architecture.md §10.5). On the staging host, copy to
# `infra/compose/.env.staging` — gitignored — make it readable by its owner alone, and fill every value:
#
#   cp infra/compose/.env.staging.example infra/compose/.env.staging && chmod 600 infra/compose/.env.staging
#
# Every secret is generated on the host, never chosen and never reused from another environment:
#
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
#
# Synthetic values protecting synthetic data (§12.5.3 holds production's secrets in OpenBao). Two of them can never
# be rotated without losing data, and say so below.

# ── The release ────────────────────────────────────────────────────────────────────────────────────────────────────
# The commit sha the image job published, for all four images. `infra/staging/deploy.sh` writes it; by hand, a sha
# and never a branch name, so the stack can always say what it is running and a rollback has a name to go back to.
IMAGE_TAG=

# ── Where the stack's data lives on the host ─────────────────────────────────────────────────────────────────────────
# One directory per project and environment, the host's `/opt/<project>/<environment>` convention: `postgres/`,
# `redis/` and `storage/` beneath it, each bind-mounted into its service. Made once, before the first deploy:
#   sudo install -d -o "$USER" -g "$USER" -m 750 /opt/easyesg /opt/easyesg/staging
DATA_DIR=/opt/easyesg/staging

# ── Hostnames, without a scheme ────────────────────────────────────────────────────────────────────────────────────
# The admin bundle calls the api at the origin it was BUILT with (the image job's VITE_API_BASE_URL), not this one —
# change API_HOST and the image job's build argument together, or the console loads and reaches nothing.
WEB_HOST=staging.easyesg.md
API_HOST=api-staging.easyesg.md
ADMIN_HOST=admin-staging.easyesg.md

# ── Published ports, on 127.0.0.1 only ─────────────────────────────────────────────────────────────────────────────
# Must match the upstreams in infra/staging/nginx/easyesg-staging.conf.
API_PORT=18101
WEB_PORT=18102
ADMIN_PORT=18103

# ── PostgreSQL: the superuser and §7.6's four roles ────────────────────────────────────────────────────────────────
# Read by init.sh on a FRESH volume only. Changing one later changes nothing in the database until init.sh is re-run
# by hand against it (its header says how).
POSTGRES_PASSWORD=
ESG_APP_PASSWORD=
ESG_WORKER_PASSWORD=
ESG_ADMIN_RO_PASSWORD=
ESG_MIGRATOR_PASSWORD=

# ── The export store's root keys ───────────────────────────────────────────────────────────────────────────────────
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── The HTTP tier ──────────────────────────────────────────────────────────────────────────────────────────────────
# The pepper is permanent: changing it makes every stored password unverifiable.
AUTH_PASSWORD_PEPPER=
AUTH_JWT_SECRET=
AUTH_ADMIN_SECRET=

# ── Both entrypoints ───────────────────────────────────────────────────────────────────────────────────────────────
# Permanent too: changing it makes every sealed column unreadable until re-encrypted.
SECRET_ENCRYPTION_KEY=
# At least 32 characters.
UNSUBSCRIBE_SIGNING_KEY=

# ── apps/web ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Seals the session cookie; at least 32 bytes.
SESSION_SECRET=

# ── Mail (the worker) ──────────────────────────────────────────────────────────────────────────────────────────────
# `log` writes each message to the worker's log, links at debug — read them with
#   docker compose -f infra/compose/docker-compose.staging.yml --env-file infra/compose/.env.staging logs worker
# `smtp` with the five values below sends through Gmail's relay, non_functional_requirements.md OQ-17's pre-production
# exception: a 16-character app password, never the account password, from an account with 2-Step Verification on.
EMAIL_PROVIDER=log
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
